B2_PRIVATE_APPLICATION_KEY=your_private_read_key
B2_WRITE_BUCKET_NAME=your_write_bucket_name
B2_WRITE_APPLICATION_KEY_ID=your_write_key_id
B2_WRITE_APPLICATION_KEY=your_write_key
B2_TRANSIENT_BUCKET_NAME=your_second_bucket_name_for_copy_demo
